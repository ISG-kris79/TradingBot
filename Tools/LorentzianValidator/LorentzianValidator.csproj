<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LorentzianValidator</RootNamespace>
    <AssemblyName>LorentzianValidator</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Binance.Net" Version="12.8.1" />
    <PackageReference Include="Skender.Stock.Indicators" Version="2.7.1" />
  </ItemGroup>
  <!-- [v5.23.0] 라이브와 백테스트 동일 코드 보장 — 메인 프로젝트의 LorentzianV2 파일 직접 참조 -->
  <ItemGroup>
    <Compile Remove="LorentzianAnnEngine.cs" />
    <Compile Remove="LorentzianFeatures.cs" />
    <Compile Include="..\..\Services\LorentzianV2\LorentzianAnnEngine.cs" Link="Shared\LorentzianAnnEngine.cs" />
    <Compile Include="..\..\Services\LorentzianV2\LorentzianFeatures.cs" Link="Shared\LorentzianFeatures.cs" />
    <Compile Include="..\..\Services\LorentzianV2\LorentzianGuard.cs" Link="Shared\LorentzianGuard.cs" />
    <!-- [v5.33.0] 엘리엇 파동 엔진 — 라이브(TradingEngine.AnalyzeElliottWaveEntryAsync)와 동일 코드로 백테 재생검증 -->
    <Compile Include="..\..\Services\ElliottWaveEngine.cs" Link="Shared\ElliottWaveEngine.cs" />
  </ItemGroup>
</Project>
