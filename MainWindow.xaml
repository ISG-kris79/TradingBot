                            </MenuItem>
                        </Menu>

                        <!-- User & Settings -->
                        <Button Content="👤"
                                Width="32"
                                Height="32"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="btnProfile_Click"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Profile"/>
                        <!-- Settings moved to main controls area -->
                        <Border Width="16" Margin="0,0,0,0"
                                ToolTip="Settings"/>

                        <!-- Window Controls -->
                        <Button Content="─"
                                Width="38"
                                Height="32"
                                Background="Transparent"
                                Foreground="#6B7280"
                                BorderThickness="0"
                                FontSize="14"
                                Click="OnMinimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#2D3454"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="☐"
                                Width="38"
                                Height="32"
                                Background="Transparent"
                                Foreground="#6B7280"
                                BorderThickness="0"
                                FontSize="14"
                                Click="OnMaximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#2D3454"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕"
                                Width="38"
                                Height="32"
                                Background="Transparent"
                                Foreground="#6B7280"
                                BorderThickness="0"
                                FontSize="14"
                                Click="OnClose_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ErrorBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1"
                         x:Name="pgScanning"
                         Height="3"
                         Background="Transparent"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0"/>

            <!-- [v5.22.6] 초기학습 진행 배너 제거 — AI 시스템 폐기 (2026-04-28) -->

            <!-- MAIN CONTENT -->
            <TabControl Grid.Row="2"
                        Margin="16">
                <!-- DASHBOARD TAB -->
                <TabItem Header="📊  대시보드">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar (200px 컴팩트) -->
                        <ScrollViewer Grid.Column="0"
                                      Style="{StaticResource MinimalScrollViewer}"
                                      Margin="0,0,16,0">
                            <StackPanel>

                            <!-- Account Info Card (좌측 상단) -->
                            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="💰 계좌 정보" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="총 자산" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalEquity}"
                                                   Foreground="{Binding EquityColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="가용 잔고" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AvailableBalance}"
                                                   Foreground="#A5B4FC" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="투입 수익" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NetTransferInfo}"
                                                   Foreground="{Binding NetTransferColor}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="수익률" Foreground="#6B7280" FontSize="10"
                                                   ToolTip="(현재 총자산 − 순투입금) ÷ 순투입금 × 100"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CapitalReturnPct, StringFormat={}{0:+0.00;-0.00;0.00}%}"
                                                   Foreground="{Binding NetTransferColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="거래당 평균%" Foreground="#6B7280" FontSize="10"
                                                   ToolTip="닫힌 거래(분할청산 row 포함) 의 PnL% 평균"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AverageRoe, StringFormat={}{0:F2}%}"
                                                   Foreground="{StaticResource WarningBrush}" FontSize="11" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="포지션" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPositionInfo}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

            <!-- [v5.22.6] 좌측 학습/감지 카드 제거 — AI 시스템 폐기 (2026-04-28)
                 학습완료/펌프스캔/거래량급증/급등감지 모두 PUMP/AI 관련 → 의미 없음 -->


                            <!-- [v5.0.3] MAJOR TODAY 카테고리 통계 카드 -->
                            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="💎 메이저(일)" FontSize="10" FontWeight="Bold"
                                               Foreground="#00E5FF" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="손익" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MajorStats.TodayPnLText}"
                                                   Foreground="{Binding MajorStats.TodayPnLColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="진입수" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MajorStats.EntriesText}"
                                                   Foreground="#A5B4FC" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="승률" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MajorStats.WinRateText}"
                                                   Foreground="{Binding MajorStats.WinRateColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- [v5.22.50] 알트(일) — 메이저 외 모든 카테고리 통합 (SQUEEZE+BB_WALK+GENERIC+PUMP+SPIKE) -->
                            <!--   슬롯 정책 (메이저 / 알트 통합) 과 일관 -->
                            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🪙 알트(일)" FontSize="10" FontWeight="Bold"
                                               Foreground="#FBBF24" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="손익" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AltStats.TodayPnLText}"
                                                   Foreground="{Binding AltStats.TodayPnLColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="진입수" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AltStats.EntriesText}"
                                                   Foreground="#A5B4FC" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="승률" Foreground="#6B7280" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AltStats.WinRateText}"
                                                   Foreground="{Binding AltStats.WinRateColor}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Main Content Area -->
                        <!-- [v5.28.3] 카드형 실시간 대시보드 — 진입중 포지션 카드 + 진입임박 큐 + 로그 -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="352"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT: 진입 중 포지션 카드 ═══ -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="진입 중 포지션" FontSize="14" FontWeight="Bold" Foreground="#E6ECFF" VerticalAlignment="Center"/>
                                    <Border Background="#111A33" BorderBrush="#274060" BorderThickness="1" CornerRadius="999" Padding="9,1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalPositionInfo}" FontSize="10" FontFamily="Consolas" Foreground="#00E5FF"/>
                                    </Border>
                                    <TextBlock Text="● 실시간 · 코인별 백그라운드 감시" FontSize="10" Foreground="#00E676" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding MarketDataList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- CARD — 진입중일 때만 표시 -->
                                                <Border Width="368" Margin="0,0,12,12" CornerRadius="14"
                                                        Background="#141A33" BorderBrush="#252B48" BorderThickness="1"
                                                        Cursor="Hand"
                                                        MouseDown="PositionCard_MouseDoubleClick"
                                                        Visibility="{Binding IsPositionActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- accent stripe -->
                                                        <Border Grid.Column="0" Background="{Binding CardAccentBrush}" CornerRadius="14,0,0,14"/>
                                                        <StackPanel Grid.Column="1" Margin="14,13,14,12">

                                                            <!-- HEAD: symbol + side + strategy + 청산 -->
                                                            <Grid Margin="0,0,0,10">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Symbol}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                                    <Border Background="{Binding PositionSideColor}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding PositionSide}" FontSize="9" FontWeight="Bold" Foreground="#0F172A"/>
                                                                    </Border>
                                                                    <Border Background="{Binding StrategyBg}" CornerRadius="5" Padding="6,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                            Visibility="{Binding StrategyName, Converter={StaticResource NullToCollapsedConverter}}">
                                                                        <TextBlock Text="{Binding StrategyName}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <Button Content="청산" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding Symbol}"
                                                                        Style="{StaticResource DangerButtonStyle}" FontSize="11" Padding="12,5"/>
                                                            </Grid>

                                                            <!-- ROE + PnL -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <TextBlock Text="{Binding ProfitRate, StringFormat={}{0:+0.0;-0.0}%}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                                                           Foreground="{Binding ProfitColor}" VerticalAlignment="Center"/>
                                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProfitUsdt}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{Binding ProfitColor}"/>
                                                                    <TextBlock Text="{Binding EntryMarginUsdt, StringFormat='마진 {0}'}" FontSize="10" Foreground="#5B6480"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- PRICE LADDER -->
                                                            <Grid Height="26" Margin="2,2,2,8">
                                                                <Border VerticalAlignment="Center" Height="6" CornerRadius="3">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#59FF5370" Offset="0"/>
                                                                            <GradientStop Color="#40252B48" Offset="0.5"/>
                                                                            <GradientStop Color="#5900E676" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <!-- entry marker -->
                                                                <Grid VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding LadderEntryPct, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                        <ColumnDefinition Width="{Binding LadderEntryRemain, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="1" HorizontalAlignment="Left" Width="9" Height="9" Fill="White" Stroke="#0A0E27" StrokeThickness="2" Margin="-5,0,0,0"/>
                                                                </Grid>
                                                                <!-- trail marker -->
                                                                <Grid VerticalAlignment="Center" Visibility="{Binding HasTrail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding LadderTrailPct, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                        <ColumnDefinition Width="{Binding LadderTrailRemain, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Rectangle Grid.Column="1" HorizontalAlignment="Left" Width="2" Height="18" Fill="#FFB300" Margin="-1,0,0,0"/>
                                                                </Grid>
                                                                <!-- current marker -->
                                                                <Grid VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding LadderCurrentPct, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                        <ColumnDefinition Width="{Binding LadderCurrentRemain, Converter={StaticResource StarGridLengthConverter}}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="1" HorizontalAlignment="Left" Width="13" Height="13" Fill="#00E5FF" Stroke="#0A0E27" StrokeThickness="2" Margin="-6,0,0,0"/>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- ladder values -->
                                                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                                                <StackPanel HorizontalAlignment="Left">
                                                                    <TextBlock Text="손절" FontSize="9" Foreground="#ff8aa0"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#ff8aa0">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource PriceFormattingConverter}">
                                                                                <Binding Path="Symbol"/><Binding Path="StopLossPrice"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Left">
                                                                    <TextBlock Text="진입" FontSize="9" Foreground="#94A3B8"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#CBD5E1">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource PriceFormattingConverter}">
                                                                                <Binding Path="Symbol"/><Binding Path="EntryPrice"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Left" Visibility="{Binding HasTrail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="트레일" FontSize="9" Foreground="#FFB300"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#FFB300">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource PriceFormattingConverter}">
                                                                                <Binding Path="Symbol"/><Binding Path="TrailingStopPrice"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Right">
                                                                    <TextBlock Text="현재" FontSize="9" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#00E5FF">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource PriceFormattingConverter}">
                                                                                <Binding Path="Symbol"/><Binding Path="LastPrice"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </UniformGrid>

                                                            <!-- EXIT TRIGGER CHIP -->
                                                            <Border Background="#0E1430" BorderBrush="#252B48" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,0,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding ExitTriggerIcon}" FontSize="15" VerticalAlignment="Top" Margin="0,0,9,0"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ExitTriggerTitle}" FontSize="12" FontWeight="Bold" Foreground="{Binding ExitTriggerColor}" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding ExitTriggerDetail}" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- META -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding SignalSource}" FontSize="10" Foreground="#5B6480" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding RSI_1H, StringFormat='· RSI {0:F0}'}" FontSize="10" Foreground="#5B6480" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Trend4H, StringFormat='· 4h {0}'}" FontSize="10" Foreground="#5B6480" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- 빈 상태 안내 (활성 포지션 없을 때) -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding NoActivePositions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🌙" FontSize="34" HorizontalAlignment="Center" Opacity="0.45"/>
                                    <TextBlock Text="진입 중인 포지션이 없습니다" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,10,0,3"/>
                                    <TextBlock Text="진입 조건 충족 시 여기에 카드로 표시됩니다" FontSize="11" Foreground="#5B6480" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- ═══ RIGHT: 진입 임박 + 로그 ═══ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="188"/>
                                </Grid.RowDefinitions>

                                <!-- 진입 임박 -->
                                <Border Grid.Row="0" Background="#111629" BorderBrush="#252B48" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="진입 임박" FontSize="13" FontWeight="Bold" Foreground="#E6ECFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="게이트 근접 감시" FontSize="10" Foreground="#00E676" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding NearEntryItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#151B33" BorderBrush="#252B48" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,0,9">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <Border Background="#00E5FF" CornerRadius="5" Padding="6,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Rank}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0A0E27"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Symbol}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                    <Border CornerRadius="999" Padding="8,2" Margin="0" HorizontalAlignment="Right"
                                                                            Background="{Binding VerdictColor}">
                                                                        <TextBlock Text="{Binding Verdict}" FontSize="10" FontWeight="Bold" Foreground="#0A0E27"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                                                    <Border Background="#0E1430" BorderBrush="#252B48" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" Padding="0,5">
                                                                        <StackPanel>
                                                                            <TextBlock Text="파동" FontSize="8" Foreground="#5B6480" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding KnnText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{Binding KnnColor}" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="#0E1430" BorderBrush="#252B48" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" Padding="0,5">
                                                                        <StackPanel>
                                                                            <TextBlock Text="NW커널" FontSize="8" Foreground="#5B6480" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding NwText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{Binding NwColor}" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="#0E1430" BorderBrush="#252B48" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" Padding="0,5">
                                                                        <StackPanel>
                                                                            <TextBlock Text="DBB여유" FontSize="8" Foreground="#5B6480" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding DbbText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{Binding DbbColor}" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Background="#0E1430" BorderBrush="#252B48" BorderThickness="1" CornerRadius="7" Padding="0,5">
                                                                        <StackPanel>
                                                                            <TextBlock Text="🔥서지" FontSize="8" Foreground="#5B6480" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding SurgeText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{Binding SurgeColor}" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </UniformGrid>
                                                                <TextBlock Text="{Binding NeedText}" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- 로그 + 알림 -->
                                <Border Grid.Row="1" Background="#111629" BorderBrush="#252B48" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Margin="0,0,6,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="📡 실시간 로그" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                            <ListBox Grid.Row="1" ItemsSource="{Binding FastLogs}" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="0,1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{Binding Converter={StaticResource LogTextToColorConverter}}"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                        <Grid Grid.Column="1" Margin="6,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="⚠ 긴급 알림" FontSize="11" FontWeight="Bold" Foreground="#FF5370" Margin="0,0,0,6"/>
                                            <ListBox Grid.Row="1" x:Name="lstAlerts" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="0,1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Foreground="#FF9DB0"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TRADE HISTORY TAB -->
                <TabItem Header="📈  매매기록">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,16">
                            <TextBlock Text="Start:"
                                       VerticalAlignment="Center"
                                       Foreground="#9CA3AF"
                                       Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding StartDate}"
                                        Width="130"
                                        Margin="0,0,16,0"/>

                            <TextBlock Text="End:"
                                       VerticalAlignment="Center"
                                       Foreground="#9CA3AF"
                                       Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding EndDate}"
                                        Width="130"
                                        Margin="0,0,16,0"/>

                            <Button Content="🔍 SEARCH"
                                    Command="{Binding LoadHistoryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="110"
                                    Height="36"
                                    Margin="0,0,12,0"/>

                            <Button Content="� Sync"
                                    Command="{Binding SyncPositionsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="90"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    ToolTip="거래소 포지션 동기화 (누락된 청산 복구)"/>

                            <Button Content="�📥 Export CSV"
                                    Command="{Binding ExportHistoryCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Width="130"
                                    Height="36"
                                    Margin="0,0,16,0"/>

                            <TextBlock Text="{Binding PositionHistory.Count, StringFormat='총 {0}건'}"
                                       VerticalAlignment="Center"
                                       Foreground="#6B7280"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Stats Panel -->
                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Padding="24"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="WIN RATE"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding WinRate, StringFormat={}{0:F1}%}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="TOTAL PROFIT"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N2} USDT}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TotalProfit, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalProfit, Converter={StaticResource LessThanConverter}, ConverterParameter=0}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="AVERAGE ROI"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding AverageRoe, StringFormat={}{0:F2}%}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="매매 건수"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding PositionHistory.Count}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 매매 기록 -->
                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}"
                                Padding="0"
                                Margin="0">
                            <DataGrid ItemsSource="{Binding PositionHistory}"
                                      SelectedItem="{Binding SelectedPositionHistory, Mode=TwoWay}"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="진입시각" Binding="{Binding OpenTimeText}" Width="150"/>
                                    <DataGridTextColumn Header="종료시각" Binding="{Binding CloseTimeText}" Width="150"/>
                                    <DataGridTextColumn Header="심볼" Binding="{Binding Symbol}" Width="120"/>
                                    <DataGridTextColumn Header="방향" Binding="{Binding SideKr}" Width="70"/>
                                    <DataGridTextColumn Header="평균진입" Binding="{Binding AvgEntryPrice, StringFormat=N4}" Width="130"/>
                                    <DataGridTextColumn Header="평균청산" Binding="{Binding AvgExitPrice, StringFormat=N4}" Width="130"/>
                                    <DataGridTextColumn Header="수량" Binding="{Binding TotalQuantity, StringFormat=N4}" Width="120"/>
                                    <DataGridTextColumn Header="순손익" Binding="{Binding NetPnl, StringFormat=N4}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NetPnl, Converter={StaticResource LessThanConverter}, ConverterParameter=0}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NetPnl, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ROE%" Binding="{Binding RoePct, StringFormat={}{0:F2}%}" Width="100"/>
                                    <DataGridTextColumn Header="분할" Binding="{Binding FillCount}" Width="70"/>
                                    <DataGridTextColumn Header="구간" Binding="{Binding DurationText}" Width="80"/>
                                    <DataGridTextColumn Header="결과" Binding="{Binding ResultText}" Width="100"/>
                                    <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- [v5.22.28] 분할 상세 (TradeHistory) — 손절/익절 사유(Strategy) 컬럼 복원 -->
                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Padding="0"
                                Margin="0,8,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#1F2937" Padding="12,4">
                                    <TextBlock Foreground="#FFD700" FontWeight="Bold" FontSize="11">
                                        <Run Text="📋 분할 청산 상세 — 위 행 클릭 시 해당 심볼 필터링 ("/>
                                        <Run Text="{Binding SelectedPositionHistory.Symbol, FallbackValue='전체'}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Border>
                                <DataGrid ItemsSource="{Binding FilteredTradeHistory}"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="시각" Binding="{Binding Time, StringFormat='MM-dd HH:mm:ss'}" Width="140"/>
                                        <DataGridTextColumn Header="심볼" Binding="{Binding Symbol}" Width="120"/>
                                        <DataGridTextColumn Header="방향" Binding="{Binding Side}" Width="80"/>
                                        <DataGridTextColumn Header="가격" Binding="{Binding Price, StringFormat=N4}" Width="130"/>
                                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N4}" Width="120"/>
                                        <DataGridTextColumn Header="사유 (SL/TP)" Binding="{Binding Strategy}" Width="240">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="청산사유" Binding="{Binding ExitReason}" Width="180"/>
                                        <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat=N4}" Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PnL, Converter={StaticResource LessThanConverter}, ConverterParameter=0}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PnL, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ROE%" Binding="{Binding PnLPercent, StringFormat={}{0:F2}%}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- PERFORMANCE TAB (v3.7.0 리디자인) -->
                <TabItem Header="📊  성과분석">
                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}" Background="#0D1117">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="350"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더: 기간 탭 + 요약 -->
                        <Border Grid.Row="0" Background="#161B22" CornerRadius="12" Padding="16,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PERFORMANCE" FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Border Background="#21262D" CornerRadius="8" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="  일별  " GroupName="PerfPeriod" IsChecked="True" Margin="2" Checked="PerfDaily_Checked"
                                                         FontSize="13" FontWeight="Bold" Foreground="White" Background="#30363D"
                                                         BorderBrush="#58A6FF" BorderThickness="1" Padding="12,6"
                                                         Style="{StaticResource {x:Type ToggleButton}}"/>
                                            <RadioButton Content="  주별  " GroupName="PerfPeriod" Margin="2" Checked="PerfWeekly_Checked"
                                                         FontSize="13" FontWeight="Bold" Foreground="White" Background="#30363D"
                                                         BorderBrush="#58A6FF" BorderThickness="1" Padding="12,6"
                                                         Style="{StaticResource {x:Type ToggleButton}}"/>
                                            <RadioButton Content="  월별  " GroupName="PerfPeriod" Margin="2" Checked="PerfMonthly_Checked"
                                                         FontSize="13" FontWeight="Bold" Foreground="White" Background="#30363D"
                                                         BorderBrush="#58A6FF" BorderThickness="1" Padding="12,6"
                                                         Style="{StaticResource {x:Type ToggleButton}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PerformanceSummary}" Foreground="#7EE787" FontSize="13"
                                           FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- PnL 차트 (수익 초록 / 손실 빨강) -->
                        <Border Grid.Row="1" Background="#161B22" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                            <lvc:CartesianChart Series="{Binding PerformanceSeries}" LegendLocation="None"
                                               AnimationsSpeed="0:0:0.3" Hoverable="True" Background="Transparent"
                                               xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding PerformanceLabels}" Foreground="#8B949E" FontSize="11" LabelsRotation="-30">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Foreground="#8B949E" FontSize="11" LabelFormatter="{Binding YFormatter}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="#21262D" StrokeThickness="1" StrokeDashArray="4,4"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Border>

                        <!-- 달력 뷰 (7열 그리드) -->
                        <Border Grid.Row="2" Background="#161B22" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="DAILY P&amp;L CALENDAR" FontSize="13" FontWeight="Bold" Foreground="#E6EDF3" Margin="4,0,0,10"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CellBackground}" CornerRadius="8" Padding="6,8" Margin="3"
                                                    BorderBrush="{Binding PnlColor}" BorderThickness="1">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DayLabel}" Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PnlDisplay}" Foreground="{Binding PnlColor}"
                                                               FontFamily="Consolas" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding TradeCountDisplay}" Foreground="#8B949E" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>


            </TabControl>

            <!-- UNIFIED FOOTER BAR (40px) — Log | Status | Clock | Connection -->
            <Border Grid.Row="3"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#2D3454"
                    CornerRadius="0,0,12,12">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                      BlurRadius="6"
                                      ShadowDepth="0"
                                      Opacity="0.2"/>
                </Border.Effect>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bell icon + Footer log -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#0A1220"
                                CornerRadius="5"
                                Padding="6,3"
                                Margin="0,0,10,0">
                            <TextBlock Text="🔔"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               x:Name="lblFooter"
                               Text="SYSTEM READY  •  WAITING FOR COMMAND"
                               Foreground="#A5B4FC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource PrimaryColor}"
                                              BlurRadius="4"
                                              ShadowDepth="0"
                                              Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Right: Profile | Telegram | Clock | Connected -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtMajorProfileStatus"
                                   Text="● Major Profile: Balanced"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   Margin="0,0,14,0"/>
                        <TextBlock x:Name="txtTelegramStatus"
                                   Text="Telegram: Offline"
                                   Foreground="#6B7280"
                                   FontSize="10"
                                   Margin="0,0,14,0"/>
                        <!-- Live Clock -->
                        <Border Background="#0A1220"
                                BorderBrush="#1E3A5F"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3"
                                Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtDateDisplay"
                                           Text="----/--/--"
                                           Foreground="#4B5563"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtTimeDisplay"
                                           Text="--:--:--"
                                           Foreground="#00E5FF"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Connection -->
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Binance  •  Connected"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
