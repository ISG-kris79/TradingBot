                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Main Controls (Col 4) -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Exchange Selector - Hidden -->
                        <ComboBox x:Name="cmbExchange"
                                  Width="130"
                                  Height="34"
                                  SelectedIndex="0"
                                  Margin="0,0,12,0"
                                  Background="{StaticResource BackgroundLightBrush}"
                                  Foreground="#4B5563"
                                  BorderBrush="{StaticResource PrimaryBrush}"
                                  FontWeight="SemiBold"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  FontSize="18"
                                  Visibility="Collapsed"
                                  IsEnabled="False">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#252B48"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="20"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#2D3454"/>
                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1A1F3A"/>
                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="🟡 Binance"/>
                        </ComboBox>
                        <Button x:Name="btnSettings"
                                Content="⚙"
                                Width="36"
                                Height="36"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="btnSettings_Click"
                                Padding="0"
                                Margin="0,0,8,0"
                                ToolTip="Settings"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="btnStart"
                                Content="▶ START"
                                Width="120"
                                Height="38"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="btnStart_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,8,0"/>
                        <Button x:Name="btnStop"
                                Content="⏹ STOP"
                                Width="105"
                                Height="38"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="btnStop_Click"
                                IsEnabled="False"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- 수동 진입 LONG/SHORT 버튼 -->
                        <Border BorderBrush="#2D3142" BorderThickness="1,0,0,0" Margin="12,0,0,0" Padding="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▲ LONG"
                                        Width="85" Height="32"
                                        FontSize="12" FontWeight="Bold"
                                        Foreground="White"
                                        Command="{Binding ManualLongCommand}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#1B5E20"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2E7D32"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#388E3C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="▼ SHORT"
                                        Width="85" Height="32"
                                        FontSize="12" FontWeight="Bold"
                                        Foreground="White"
                                        Command="{Binding ManualShortCommand}"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#B71C1C"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#C62828"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#D32F2F"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Controls (Col 6) -->
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Admin Menu -->
                        <Menu x:Name="mnuAdmin"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Visibility="Collapsed">
