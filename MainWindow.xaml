                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                        <!-- Positions Pill -->
                        <Border Background="#0A1220"
                                BorderBrush="#1E3A5F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6">
                            <StackPanel>
                                <TextBlock Text="포지션"
                                           Foreground="#4B5563"
                                           FontSize="8"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalPositionInfo"
